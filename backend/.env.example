# ==============================================================================
# Vinay Agri Inputs - Backend Environment Configuration Template
# Copy this file to backend/.env and provide actual local development values.
# NEVER commit the real .env file with secrets to Git.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vinay_agri_db
DB_USER=root
DB_PASSWORD=your_local_mysql_password_placeholder

# Security & JWT Authentication (Required: minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars_long
JWT_EXPIRATION_MS=86400000

# Google OAuth2 Authentication (Google Cloud Console Web Client ID)
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
