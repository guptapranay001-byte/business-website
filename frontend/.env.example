# ==============================================================================
# Vinay Agri Inputs Frontend Configuration Template
# Copy this file to .env (or .env.local) and provide actual values for local development.
# ==============================================================================

# Backend Spring Boot API base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Google OAuth2 Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
